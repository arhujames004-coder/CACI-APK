# ==============================================================
# Tithe Storehouse Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env with real secrets to public git repositories!
# ==============================================================

# Church Information
CHURCH_NAME="Christ Apostolic Church International"
CHURCH_PHONE="+233240123456"
CHURCH_SHORTCODE="*384*100#"
CURRENCY="GHS"

# Flask Settings
FLASK_ENV="production"
FLASK_DEBUG="0"
SECRET_KEY="replace_with_a_long_random_secret_string"
DATABASE_PATH="tithe_storehouse.db"
SERVER_HOST="0.0.0.0"
SERVER_PORT="5000"
BASE_URL="http://localhost:5000"

# Charge Handling (Transparent processing fee)
# FEE_TYPE options: "PERCENT" (e.g. 1.95%) or "FLAT" (e.g. GHS 1.50)
FEE_TYPE="PERCENT"
FEE_VALUE="1.95"
FEE_CAP="25.00"

# Paystack API Credentials (Mobile Money & Cards)
# Test keys begin with 'sk_test_' and 'pk_test_'
# Live keys begin with 'sk_live_' and 'pk_live_'
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
# Paystack Webhook Secret (Leave blank if using PAYSTACK_SECRET_KEY as HMAC key)
PAYSTACK_WEBHOOK_SECRET="sk_test_your_paystack_secret_key"

# Africa's Talking API Credentials (USSD & SMS)
# In sandbox, username is 'sandbox' and API key is from your Africa's Talking sandbox account
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="atsk_your_africastalking_api_key"
# Approved alphanumeric sender ID (leave blank or specify church name)
AFRICASTALKING_SENDER_ID="STOREHOUSE"

# Admin Dashboard Credentials
# Default password below is 'GraceTithe2026!'
# Generate a new hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="scrypt:32768:8:1$u7xV4F1o0hO$98e1f5798993f1bb1ad675276e0176df9d4b684cb3a7042a5a54b35e5e4905d5dbad4cb2c48dafa310d7eb599d123b379e49c716fe00742d45c60f274cb32d43"

# Rate Limiting (Requests per minute per IP / phone)
RATE_LIMIT_PER_MINUTE="60"

# AI Studio Platform Key Placeholder (Retained for environment compatibility)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
